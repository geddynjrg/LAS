{
  "name": "uwezo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "prisma migrate deploy && next dev --turbopack --port 3002",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "schema": "openapi-typescript http://uwezo-api.ddev.site/api/docs/json -o ./lib/api/schema/schema.d.ts --prettier && echo 'Schema updated successfully'",
    "schema:validate": "tsc --noEmit --skipLibCheck ./lib/api/schema/schema.d.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx lib/worker/sync-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@tabler/icons-react": "^3.17.0",
    "@workspace/ui": "workspace:*",
    "nanoid": "^5.1.5",
    "next": "15.3.2",
    "next-auth": "5.0.0-beta.25",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.13.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@types/node": "^22.13.17",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.3",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
