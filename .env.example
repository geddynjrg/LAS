# UWEZO Portal Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# WEB (Frontend) Configuration
# =============================================================================

# Authentication Configuration
AUTH_SECRET=changeme

# Web Application Database (SQLite for local storage)
DATABASE_URL="mysql://root:root@localhost:55000/uwezo_web"

# File Storage Configuration
UPLOAD_DIR="./public/uploads"  # Directory for storing uploaded files
MAX_FILE_SIZE="10485760"      # 10MB in bytes

# External API Access
EXTERNAL_API_KEY=changeme

# Next.js CRON Configuration
CRON_SECRET=changeme

# =============================================================================
# ADMIN (Backend) Configuration  
# =============================================================================

# Database Configuration (Required)
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Security Configuration (Required) 
# Generate secure values with: openssl rand -base64 55
HASH_SALT=changeme

# JWT Authentication (Required)
# Generate secure values with: openssl rand -base64 32
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# SMS Providers (Optional)
# EbisCloud SMS Configuration
#EBISCLOUD_SMS_API_KEY=your_ebiscloud_api_key_here
#EBISCLOUD_SMS_API_URL=https://api.ebiscloud.com/sms/v1/send

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Environment
DRUPAL_ENV=production

# Port Configuration
HTTP_PORT=80
HTTPS_PORT=443

# Domain Configuration
# For local development, use localhost and admin.localhost
# For production, use your actual domains
WEB_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost

# SSL Certificate Configuration for Development
# Choose ONE of the following approaches:

# Option 1: mkcert (recommended) - locally-trusted certificates
# Uncomment these lines if using mkcert
#MKCERT_CA_PATH=/home/user/.local/share/mkcert/rootCA.pem
#NODE_EXTRA_CA_CERTS=/tmp/mkcert-ca.pem

# Option 2: Self-signed certificates - bypass SSL verification
# Uncomment this line if using self-signed certificates
#NODE_TLS_REJECT_UNAUTHORIZED=0

# Production: Leave all above commented out for real certificates

# =============================================================================
# NGINX IP Whitelist Configuration
# =============================================================================

# Allowed IPs for accessing the application (nginx geo format)
# Format: "IP_ADDRESS 1;" with semicolon separator for multiple IPs
# Examples:
# ALLOWED_IPS=203.0.113.10 1;
# ALLOWED_IPS=203.0.113.10 1; 198.51.100.0/24 1; 192.0.2.0/28 1;
ALLOWED_IPS=

# =============================================================================
# Let's Encrypt Configuration
# =============================================================================

# Email address for Let's Encrypt certificate notifications (required for production)
LETSENCRYPT_EMAIL=

# Note: Domain names are configured above in the Domain Configuration section
# For production with Let's Encrypt, set actual domain names (not localhost)