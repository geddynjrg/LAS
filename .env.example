# Next.js authentication secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme

UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"

# Drupal API access key
# Generate with: uuidgen (Linux/Mac) or [guid]::NewGuid() (PowerShell)
# Format: UUID v4 (e.g., 0eb29f8d-7dcc-48b2-aae9-1d21eeae3f4a)
EXTERNAL_API_KEY=changeme

# Next.js CRON secret
# Generate with: uuidgen (Linux/Mac) or [guid]::NewGuid() (PowerShell)
# Format: UUID v4 (e.g., 0eb29f8d-7dcc-48b2-aae9-1d21eeae3f4a)
CRON_SECRET=changeme

DB_NAME=drupal
DB_USER=drupal
# Generate with: openssl rand -base64 32 | tr -d "=+/" | cut -c1-25
DB_PASSWORD=changeme_secure_password
# Generate with: openssl rand -base64 32 | tr -d "=+/" | cut -c1-25
DB_ROOT_PASSWORD=changeme_root_password

# Drupal hash salt (must be at least 74 characters)
# Generate with: openssl rand -hex 74
HASH_SALT=changeme_generate_secure_hash

# JWT secrets for API authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme_generate_jwt_secret
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=changeme_generate_jwt_refresh_secret

EBISCLOUD_SMS_API_KEY=
EBISCLOUD_SMS_API_URL=https://sms.ebisclouderp.com/api/sms/sendsms
EBISCLOUD_SMS_SHORTCODE=
# Optional - defaults to 0 if not set
# EBISCLOUD_SMS_SERVICE_ID=0

# SMTP Configuration for production email delivery
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password

HTTP_PORT=80
HTTPS_PORT=443
WEB_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost

# IP Whitelist (optional) - Separate lists for web and admin domains
# Format: "IP_RANGE 1;" (nginx geo format)
# Examples:
#   Single IP: "192.168.1.100 1;"
#   IP range: "192.168.0.0/24 1;" (allows 192.168.0.*)
#   Multiple: "192.168.0.0/24 1; 10.0.0.5 1; 172.16.0.0/16 1;"
#   Allow all: "0.0.0.0/0 1;"

# Web domain IP whitelist (public-facing, typically more permissive)
WEB_ALLOWED_IPS=

# Admin domain IP whitelist (typically more restrictive for security)
ADMIN_ALLOWED_IPS=

# Let's Encrypt Configuration (required for SSL setup)
# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=admin@example.com