# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries

# Ignore Drupal's file directory
/web/sites/*/files/*
# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore development environment files
#/.ddev/

# Ignore files
.DS_Store
services.yml
CLAUDE.local.md

/web/sites/default/settings.local.php
/web/sites/default/settings.ddev.php
/web/sites/default/settings.ddev.redis.php
/web/sites/default/files
/web/sites/private

# Ignore files generated by GrumPHP
.php-cs-fixer.cache

# ignore all node_modules
node_modules/

# ignore all vendor
vendor/

# ignore all drush
drush/
