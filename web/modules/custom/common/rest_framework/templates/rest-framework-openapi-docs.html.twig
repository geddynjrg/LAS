{#
/**
 * @file
 * Default theme implementation for OpenAPI documentation.
 *
 * Available variables:
 * - spec: The OpenAPI specification array.
 */
#}
<div class="rest-framework-rest-openapi-docs">
  <div id="openapi-ui"></div>
</div>

<script>
  window.onload = function() {
    const spec = {{ spec|json_encode|raw }};
    const ui = SwaggerUIBundle({
      spec: spec,
      dom_id: '#openapi-ui',
      deepLinking: true,
      presets: [
        SwaggerUIBundle.presets.apis,
        SwaggerUIBundle.SwaggerUIStandalonePreset
      ],
      plugins: [
        SwaggerUIBundle.plugins.DownloadUrl
      ],
      layout: "BaseLayout",
    });
    window.ui = ui;
  };
</script>
