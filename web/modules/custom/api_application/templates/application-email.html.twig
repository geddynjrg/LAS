{#
/**
 * @file
 * Email template for loan applications - Email client compatible.
 *
 * Available variables:
 * - application: The application entity.
 * - site_name: The site name.
 * - recipient_email: The recipient email address.
 */
#}
<!doctype html>
<html>
<head>
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>{{ application.getApplicationId() }} - {{ site_name }}</title>
    <style>
        @media only screen and (max-width: 620px) {
            table[class=body] h1 {
                font-size: 28px !important;
                margin-bottom: 10px !important;
            }
            table[class=body] p,
            table[class=body] ul,
            table[class=body] ol,
            table[class=body] td,
            table[class=body] span,
            table[class=body] a {
                font-size: 16px !important;
            }
            table[class=body] .wrapper,
            table[class=body] .article {
                padding: 10px !important;
            }
            table[class=body] .content {
                padding: 0 !important;
            }
            table[class=body] .container {
                padding: 0 !important;
                width: 100% !important;
            }
            table[class=body] .main {
                border-left-width: 0 !important;
                border-radius: 0 !important;
                border-right-width: 0 !important;
            }
        }
        @media all {
            .ExternalClass {
                width: 100%;
            }
            .ExternalClass,
            .ExternalClass p,
            .ExternalClass span,
            .ExternalClass font,
            .ExternalClass td,
            .ExternalClass div {
                line-height: 100%;
            }
        }
    </style>
</head>
<body class style="background-color: #f6f6f6; font-family: sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.4; margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="body" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; background-color: #f6f6f6; width: 100%;" width="100%" bgcolor="#f6f6f6">
        <tr>
            <td style="font-family: sans-serif; font-size: 14px; vertical-align: top;" valign="top">&nbsp;</td>
            <td class="container" style="font-family: sans-serif; font-size: 14px; vertical-align: top; display: block; max-width: 580px; padding: 10px; width: 580px; Margin: 0 auto;" width="580" valign="top">

                <!-- HEADER -->
                <div class="header" style="padding: 20px 0;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%;">
                        <tr>
                            <td class="align-center" width="100%" style="font-family: sans-serif; font-size: 14px; vertical-align: top; text-align: center;" valign="top" align="center">
                                <h1 style="color: #47103f; font-size: 24px; margin: 0; font-weight: bold;">{{ site_name }}</h1>
                                <p style="color: #666; font-size: 16px; margin: 5px 0 0 0;">{{ 'Loan Application'|t }}</p>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="content" style="box-sizing: border-box; display: block; Margin: 0 auto; max-width: 580px; padding: 10px;">

                    <!-- MAIN CONTENT -->
                    <table role="presentation" class="main" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; background: #ffffff; border-radius: 3px; width: 100%;" width="100%">
                        <tr>
                            <td class="wrapper" style="font-family: sans-serif; font-size: 14px; vertical-align: top; box-sizing: border-box; padding: 20px;" valign="top">
                                <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%;" width="100%">

                                    <!-- GREETING -->
                                    <tr>
                                        <td style="font-family: sans-serif; font-size: 14px; vertical-align: top;" valign="top">
                                            <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">{{ 'Dear Recipient,'|t }}</p>
                                            <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">{{ 'Please find attached the loan application details for the following application:'|t }}</p>
                                        </td>
                                    </tr>

                                    <!-- APPLICATION SUMMARY -->
                                    <tr>
                                        <td style="font-family: sans-serif; font-size: 14px; vertical-align: top;" valign="top">
                                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%; background-color: #f8f9fa; padding: 20px; border-radius: 5px;" width="100%" bgcolor="#f8f9fa">
                                                <tr>
                                                    <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 20px;" valign="top">
                                                        <h2 style="color: #47103f; font-size: 18px; margin: 0 0 15px 0; font-weight: bold;">{{ 'Application Summary'|t }}</h2>

                                                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%;" width="100%">
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f; width: 40%;" valign="top" width="40%">{{ 'Application ID:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.getApplicationId() }}</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Group Name:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.getGroupName() }}</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Status:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">
                                                                    {% set status = application.getStatus() %}
                                                                    {% set status_colors = {
                                                                        draft: '#9ca3af',
                                                                        pending: '#f59e0b',
                                                                        submitted: '#8b5cf6',
                                                                        under_review: '#3b82f6',
                                                                                                                        approved: '#47103f',
                                                rejected: '#ef4444',
                                                disbursed: 'rgb(183, 42, 159)',
                                                                        closed: '#6b7280',
                                                                    } %}
                                                                    <span style="background-color: {{ status_colors[status] ?: '#6c757d' }}; color: white; padding: 4px 8px; border-radius: 3px; font-size: 11px; font-weight: bold; text-transform: uppercase;">{{ status|replace({_: ' '})|title }}</span>
                                                                </td>
                                                            </tr>
                                                            {% if application.get('loan_amount').value %}
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Loan Amount:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold;" valign="top">KES {{ application.get('loan_amount').value|number_format }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Submitted On:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.getCreatedTime()|date('F j, Y - g:i A') }}</td>
                                                            </tr>
                                                            {% if application.get('county').entity %}
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'County:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.get('county').entity.getName() }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if application.get('constituency').entity %}
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Constituency:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.get('constituency').entity.getName() }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if application.get('group_registration_number').value %}
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Registration Number:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.get('group_registration_number').value }}</td>
                                                            </tr>
                                                            {% endif %}
                                                            {% if application.get('nature_of_business').value %}
                                                            <tr>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0; font-weight: bold; color: #47103f;" valign="top">{{ 'Nature of Business:'|t }}</td>
                                                                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 5px 0;" valign="top">{{ application.get('nature_of_business').value }}</td>
                                                            </tr>
                                                            {% endif %}
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <!-- ATTACHMENT NOTICE -->
                                    {% comment %} <tr>
                                        <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding-top: 20px;" valign="top">
                                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%; background-color: #e6f4ea; border-left: 4px solid #47103f;" width="100%" bgcolor="#e6f4ea">
                                                <tr>
                                                    <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding: 15px;" valign="top">
                                                        <p style="font-family: sans-serif; font-size: 14px; font-weight: bold; margin: 0; margin-bottom: 5px;">📎 {{ 'Attachment:'|t }}</p>
                                                        <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0;">{{ 'A complete PDF copy of the application has been attached to this email for your review.'|t }}</p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr> {% endcomment %}

                                    <!-- CONTACT INFO -->
                                    <tr>
                                        <td style="font-family: sans-serif; font-size: 14px; vertical-align: top; padding-top: 20px;" valign="top">
                                            <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 15px;">{{ 'If you have any questions or need additional information, please do not hesitate to contact us.'|t }}</p>
                                            <p style="font-family: sans-serif; font-size: 14px; font-weight: normal; margin: 0;">
                                                {{ 'Best regards,'|t }}<br>
                                                <strong>{{ site_name }} {{ 'Team'|t }}</strong>
                                            </p>
                                        </td>
                                    </tr>

                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- FOOTER -->
                    <div class="footer" style="clear: both; Margin-top: 10px; text-align: center; width: 100%;">
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%;" width="100%">
                            <tr>
                                <td class="content-block" style="font-family: sans-serif; vertical-align: top; padding-bottom: 10px; padding-top: 10px; color: #9a9ea6; font-size: 12px; text-align: center;" valign="top" align="center">
                                    <p style="font-family: sans-serif; font-size: 12px; font-weight: normal; margin: 0; color: #9a9ea6;">{{ 'This is an automated message. Please do not reply to this email.'|t }}</p>
                                </td>
                            </tr>
                            <tr>
                                <td class="content-block" style="font-family: sans-serif; vertical-align: top; padding-bottom: 10px; padding-top: 10px; color: #9a9ea6; font-size: 12px; text-align: center;" valign="top" align="center">
                                    <p style="font-family: sans-serif; font-size: 12px; font-weight: normal; margin: 0; color: #9a9ea6;">{{ 'Generated on'|t }} {{ 'now'|date('F j, Y \\a\\t g:i A') }}</p>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </td>
            <td style="font-family: sans-serif; font-size: 14px; vertical-align: top;" valign="top">&nbsp;</td>
        </tr>
    </table>
</body>
</html>
