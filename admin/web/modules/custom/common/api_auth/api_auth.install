<?php

/**
 * @file
 * Install, update and uninstall functions for the UWEZO Auth module.
 */

use Drupal\Core\Database\Database;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_install().
 */
function api_auth_install() {
  // Import optional configuration on module installation
  $optional_config = [
    'rest.resource.api_ecitizen_login',
  ];

  $module_path = \Drupal::service('extension.list.module')->getPath('api_auth');
  $config_storage = new FileStorage($module_path . '/config/optional');

  foreach ($optional_config as $config_name) {
    $config = $config_storage->read($config_name);
    if ($config) {
      \Drupal::configFactory()->getEditable($config_name)
        ->setData($config)
        ->save(TRUE);
    }
  }

  // Grant permissions to anonymous and authenticated users
  _api_auth_grant_ecitizen_permissions();
}

/**
 * Implements hook_uninstall().
 */
function api_auth_uninstall() {
  // Remove our configuration on uninstall
  $config_names = [
    'rest.resource.api_ecitizen_login',
  ];

  foreach ($config_names as $config_name) {
    \Drupal::configFactory()->getEditable($config_name)->delete();
  }
}

/**
 * Implements hook_schema().
 */
function api_auth_schema() {
  $db_schema = Database::getConnection()->schema();

  if (!$db_schema->tableExists('api_active_tokens')) {
    $schema['api_active_tokens'] = [
      'description' => 'Stores all active JWT tokens for tracking and revocation.',
      'fields' => [
        'id' => [
          'description' => 'Primary identifier for token record.',
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'jti' => [
          'description' => 'JWT ID (jti claim).',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
        'user_id' => [
          'description' => 'The user ID associated with this token.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'token_hash' => [
          'description' => 'Hashed token value for security.',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
        'type' => [
          'description' => 'Token type (access or refresh).',
          'type' => 'varchar',
          'length' => 16,
          'not null' => TRUE,
          'default' => 'access',
        ],
        'issued' => [
          'description' => 'Timestamp when the token was issued.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'expiration' => [
          'description' => 'Token expiration timestamp.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'ip' => [
          'description' => 'IP address of the client that requested the token.',
          'type' => 'varchar',
          'length' => 45,
          'not null' => FALSE,
        ],
        'user_agent' => [
          'description' => 'User agent of the client that requested the token.',
          'type' => 'text',
          'size' => 'normal',
          'not null' => FALSE,
        ],
        'is_revoked' => [
          'description' => 'Whether this token has been revoked.',
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'parent_id' => [
          'description' => 'ID of the parent token (for tracking refresh token chains).',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'jti' => ['jti'],
      ],
      'indexes' => [
        'token_user' => ['user_id'],
        'token_expiration' => ['expiration'],
        'token_is_revoked' => ['is_revoked'],
        'token_type' => ['type'],
        'token_parent' => ['parent_id'],
      ],
    ];

    return $schema;
  }
}

/**
 * Implements hook_update_N().
 *
 * Creates the active tokens tracking table.
 */
function api_auth_update_11001() {
  $schema = Database::getConnection()->schema();

  if (!$schema->tableExists('api_active_tokens')) {
    $schema->createTable('api_active_tokens', api_auth_schema()['api_active_tokens']);

    return t('Created JWT active tokens tracking table.');
  }

  return t('JWT active tokens tracking table already exists.');
}

/**
 * Implements hook_update_N().
 *
 * Creates the phone number field for OTP authentication.
 */
function api_auth_update_11002() {
  _api_auth_create_phone_field();

  return t('Created phone number field for OTP authentication.');
}

/**
 * Implements hook_update_N().
 *
 * Add unique index to phone number field for uniqueness constraint.
 */
function api_auth_update_11003() {
  $connection = Database::getConnection();
  $schema = $connection->schema();

  // Add unique index to phone number field.
  $table_name = 'user__field_phone_number';
  $index_name = 'field_phone_number_value_unique';

  // Check if the table exists.
  if ($schema->tableExists($table_name)) {
    // Drop existing index if it exists (in case of re-run).
    if ($schema->indexExists($table_name, $index_name)) {
      $schema->dropIndex($table_name, $index_name);
    }

    // Add unique index.
    $schema->addUniqueKey($table_name, $index_name, ['field_phone_number_value']);

    return t('Added unique constraint to phone number field.');
  }

  return t('Phone number field table not found, skipping unique constraint.');
}

/**
 * Creates the phone number field for users.
 */
function _api_auth_create_phone_field() {
  $field_name = 'field_phone_number';
  $entity_type = 'user';
  $bundle = 'user';

  // Check if field storage already exists.
  $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);

  if (!$field_storage) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'type' => 'telephone',
      'settings' => [],
    ]);
    $field_storage->save();
  }

  // Check if field config already exists.
  $field_config = FieldConfig::loadByName($entity_type, $bundle, $field_name);

  if (!$field_config) {
    $field_config = FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => $bundle,
      'label' => 'Phone Number',
      'description' => 'Phone number for OTP authentication',
      'required' => FALSE,
      'settings' => [],
    ]);
    $field_config->save();

    // Configure the form display.
    $form_display = Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load("{$entity_type}.{$bundle}.default");

    if ($form_display) {
      $form_display->setComponent($field_name, [
        'type' => 'telephone_default',
        'weight' => 5,
        'settings' => [
          'placeholder' => '+254712345678',
        ],
      ]);
      $form_display->save();
    }

    // Configure the view display.
    $view_display = Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load("{$entity_type}.{$bundle}.default");

    if ($view_display) {
      $view_display->setComponent($field_name, [
        'type' => 'telephone_link',
        'weight' => 5,
        'label' => 'above',
      ]);
      $view_display->save();
    }
  }
}

/**
 * Implements hook_update_N().
 *
 * Ensures sms_providers module is installed for OTP functionality.
 */
function api_auth_update_11004() {
  $module_handler = \Drupal::service('module_handler');
  $module_installer = \Drupal::service('module_installer');

  // Check if sms_providers module is not installed.
  if (!$module_handler->moduleExists('sms_providers')) {
    // Install the sms_providers module.
    $module_installer->install(['sms_providers']);

    return t('Installed sms_providers module for OTP functionality.');
  }

  return t('SMS providers module already installed.');
}

/**
 * Implements hook_update_N().
 *
 * Add eCitizen REST resource and permissions.
 */
function api_auth_update_11005() {
  // Import eCitizen REST resource configuration
  $module_path = \Drupal::service('extension.list.module')->getPath('api_auth');
  $config_storage = new FileStorage($module_path . '/config/optional');

  $config = $config_storage->read('rest.resource.api_ecitizen_login');
  if ($config) {
    \Drupal::configFactory()->getEditable('rest.resource.api_ecitizen_login')
      ->setData($config)
      ->save(TRUE);

    // Grant permissions
    _api_auth_grant_ecitizen_permissions();

    return t('Added eCitizen SSO login REST resource and permissions.');
  }

  return t('eCitizen REST resource configuration not found.');
}

/**
 * Grants eCitizen login permissions to roles.
 */
function _api_auth_grant_ecitizen_permissions() {
  // Grant permission to anonymous users
  $anonymous_role = \Drupal\user\Entity\Role::load('anonymous');
  if ($anonymous_role) {
    $anonymous_role->grantPermission('restful post api_ecitizen_login');
    $anonymous_role->save();
  }

  // Grant permission to authenticated users
  $authenticated_role = \Drupal\user\Entity\Role::load('authenticated');
  if ($authenticated_role) {
    $authenticated_role->grantPermission('restful post api_ecitizen_login');
    $authenticated_role->save();
  }
}
