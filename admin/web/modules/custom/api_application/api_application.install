  $update_manager->installFieldStorageDefinition('confirmation_token', 'group_member', 'api_application', $confirmation_token);

  // Add confirmation_sent_at field.
  $confirmation_sent_at = BaseFieldDefinition::create('timestamp')
    ->setLabel(t('Confirmation Sent At'))
    ->setDescription(t('Timestamp when the confirmation SMS was sent.'))
    ->setDisplayOptions('view', [
      'label' => 'inline',
      'type' => 'timestamp',
      'weight' => 11,
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', FALSE);

  $update_manager->installFieldStorageDefinition('confirmation_sent_at', 'group_member', 'api_application', $confirmation_sent_at);

  // Add confirmation_confirmed_at field.
  $confirmation_confirmed_at = BaseFieldDefinition::create('timestamp')
    ->setLabel(t('Confirmation Confirmed At'))
    ->setDescription(t('Timestamp when the member confirmed via SMS.'))
    ->setDisplayOptions('view', [
      'label' => 'inline',
      'type' => 'timestamp',
      'weight' => 12,
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', FALSE);

  $update_manager->installFieldStorageDefinition('confirmation_confirmed_at', 'group_member', 'api_application', $confirmation_confirmed_at);

  return t('SMS confirmation fields have been added to the Group Member entity.');
}

/**
 * Add declined status option to confirmation_status field.
 */
function api_application_update_11013() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();

  // Get the current field storage definition.
  $field_storage_definition = $update_manager->getFieldStorageDefinition('confirmation_status', 'group_member');

  if ($field_storage_definition) {
    // Update the allowed values to include 'declined'.
    $allowed_values = $field_storage_definition->getSetting('allowed_values');
    if (!isset($allowed_values['declined'])) {
      $allowed_values['declined'] = t('Declined');
      $field_storage_definition->setSetting('allowed_values', $allowed_values);
      $update_manager->updateFieldStorageDefinition($field_storage_definition);
    }
  }

  return t('Added declined status option to confirmation_status field.');
}

/**
 * Add requires_confirmation field to Group Member entity.
 */
function api_application_update_11014() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  // Add requires_confirmation field.
  $requires_confirmation = BaseFieldDefinition::create('boolean')
    ->setLabel(t('Requires Confirmation'))
    ->setDescription(t('Whether this member requires SMS confirmation.'))
    ->setDefaultValue(TRUE)
    ->setDisplayOptions('view', [
      'label' => 'inline',
      'type' => 'boolean',
      'weight' => 13,
    ])
    ->setDisplayOptions('form', [
      'type' => 'boolean_checkbox',
      'weight' => 13,
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);

  $update_manager->installFieldStorageDefinition('requires_confirmation', 'group_member', 'api_application', $requires_confirmation);

  return t('Requires confirmation field has been added to the Group Member entity.');
}

/**
 * Enable the symfony_mailer module for email functionality.
 */
function api_application_update_11015() {
  $module_handler = \Drupal::service('module_handler');

  if (!$module_handler->moduleExists('symfony_mailer')) {
    $module_installer = \Drupal::service('module_installer');
    $module_installer->install(['symfony_mailer']);
    return t('Symfony Mailer module has been enabled.');
  }

  return t('Symfony Mailer module was already enabled.');
}

/**
 * Add limited_role field to position_of_member taxonomy and create standard position terms.
 */
function api_application_update_11016() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_field_manager = \Drupal::service('entity_field.manager');
  $field_storage_config_storage = $entity_type_manager->getStorage('field_storage_config');
  $field_config_storage = $entity_type_manager->getStorage('field_config');

  // Create field storage for limited_role field.
  $field_storage = $field_storage_config_storage->load('taxonomy_term.field_limited_role');
  if (!$field_storage) {
    $field_storage = $field_storage_config_storage->create([
      'field_name' => 'field_limited_role',
      'entity_type' => 'taxonomy_term',
      'type' => 'boolean',
      'cardinality' => 1,
      'translatable' => FALSE,
      'settings' => [],
    ]);
    $field_storage->save();
  }

  // Create field instance for position_of_member vocabulary.
  $field_config = $field_config_storage->load('taxonomy_term.position_of_member.field_limited_role');
  if (!$field_config) {
    $field_config = $field_config_storage->create([
      'field_name' => 'field_limited_role',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'position_of_member',
      'label' => 'Limited Role',
      'description' => 'Check this if only one member can have this role per application (e.g., Chairman, Secretary, Treasurer)',
      'required' => FALSE,
      'translatable' => FALSE,
      'default_value' => [['value' => 0]],
      'settings' => [
        'on_label' => 'Limited (only one allowed)',
        'off_label' => 'Unlimited',
      ],
    ]);
    $field_config->save();
  }

  // Clear field cache.
  $entity_field_manager->clearCachedFieldDefinitions();

  // Create standard position terms with appropriate limited_role flags.
  $term_storage = $entity_type_manager->getStorage('taxonomy_term');

  $positions = [
    'Chairman' => TRUE,     // Limited - only one allowed
    'Secretary' => TRUE,    // Limited - only one allowed
    'Treasurer' => TRUE,    // Limited - only one allowed
    'Member' => FALSE,      // Unlimited - multiple allowed
    'Other' => FALSE,       // Unlimited - multiple allowed
  ];

  foreach ($positions as $position_name => $is_limited) {
    // Check if term already exists.
    $existing_terms = $term_storage->loadByProperties([
      'vid' => 'position_of_member',
      'name' => $position_name,
    ]);

    if (empty($existing_terms)) {
      // Create new term.
      $term = $term_storage->create([
        'vid' => 'position_of_member',
        'name' => $position_name,
        'field_limited_role' => $is_limited,
      ]);
      $term->save();
    } else {
      // Update existing term with limited_role flag.
      $term = reset($existing_terms);
      if ($term->hasField('field_limited_role')) {
        $term->set('field_limited_role', $is_limited);
        $term->save();
      }
    }
  }

  return t('Limited role field has been added to position_of_member taxonomy and standard position terms have been created.');
}

