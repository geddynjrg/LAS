      ],
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);

  // Install the field.
  $update_manager->installFieldStorageDefinition('group_credit_history', 'application', 'api_application', $field_storage_definition);

  return t('Group credit history field has been added to the Application entity.');
}

