/**
 * Update key_activities field from string to entity reference.
 */
function api_application_update_11018() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $database = \Drupal::database();

  // Check if update has already been applied.
  if ($database->schema()->tableExists('application__key_activities') &&
      $database->schema()->fieldExists('application__key_activities', 'key_activities_target_id')) {
    return t('Key activities field already updated to entity reference type.');
  }

  // Delete all existing applications before schema change.
  $application_storage = $entity_type_manager->getStorage('application');
  $applications = $application_storage->loadMultiple();
  $application_count = count($applications);

  if (!empty($applications)) {
    $application_storage->delete($applications);
  }

  // Get the current field definition.
  $field_storage_definition = $update_manager->getFieldStorageDefinition('key_activities', 'application');

  if ($field_storage_definition) {
    // Uninstall the old field (this will drop the old table).
    $update_manager->uninstallFieldStorageDefinition($field_storage_definition);
  }

  // Create the new field definition as entity_reference.
  $field_storage_definition = BaseFieldDefinition::create('entity_reference')
    ->setLabel(t('Key activities of the group'))
    ->setDescription(t('Select all key activities that apply.'))
    ->setRequired(TRUE)
    ->setRevisionable(TRUE)
    ->setCardinality(BaseFieldDefinition::CARDINALITY_UNLIMITED)
    ->setSetting('target_type', 'taxonomy_term')
    ->setSetting('handler', 'default:taxonomy_term')
    ->setSetting('handler_settings', [
      'target_bundles' => [
        'group_activities' => 'group_activities',
      ],
    ])
    ->setDisplayOptions('view', [
      'label' => 'visible',
      'type' => 'entity_reference_label',
      'weight' => 6,
    ])
    ->setDisplayOptions('form', [
      'type' => 'options_buttons',
      'weight' => 6,
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);

  // Install the new field.
  $update_manager->installFieldStorageDefinition('key_activities', 'application', 'api_application', $field_storage_definition);

  return t('Deleted @count existing applications and updated key_activities field to entity reference type.', [
    '@count' => $application_count,
  ]);
}

/**
 * Delete value_chain vocabulary after merging into group_activities.
 */
function api_application_update_11019(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $term_storage = $entity_type_manager->getStorage('taxonomy_term');
  $vocabulary_storage = $entity_type_manager->getStorage('taxonomy_vocabulary');

  // Delete all terms from value_chain vocabulary.
  $terms = $term_storage->loadByProperties([
    'vid' => 'value_chain',
  ]);

  if (!empty($terms)) {
    $term_storage->delete($terms);
  }

  // Delete the value_chain vocabulary.
  $vocabulary = $vocabulary_storage->load('value_chain');
  if ($vocabulary) {
    $vocabulary->delete();
  }

  return t('Deleted value_chain vocabulary and its terms (merged into group_activities).');
}

/**
 * Migrate application files from public to private storage for security.
 */
function api_application_update_11020(): string {
  $file_system = \Drupal::service('file_system');
  $entity_type_manager = \Drupal::entityTypeManager();
  $file_storage = $entity_type_manager->getStorage('file');

  $files_updated = 0;
  $files_moved = 0;
  $errors = [];

  $query = $file_storage->getQuery()
    ->condition('uri', 'public://applications/%', 'LIKE')
    ->accessCheck(FALSE);

  $fids = $query->execute();

  foreach ($fids as $fid) {
    $file = $file_storage->load($fid);
    if ($file) {
      $old_uri = $file->getFileUri();
      $new_uri = str_replace('public://applications/', 'private://applications/', $old_uri);

      $old_path = $file_system->realpath($old_uri);
      $new_path_dir = dirname($file_system->realpath($new_uri) ?: 'private://applications/');

      if ($old_path && file_exists($old_path)) {
        try {
          if (!is_dir($new_path_dir)) {
            $file_system->prepareDirectory($new_path_dir, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
          }

          $moved_uri = $file_system->move($old_uri, $new_uri, FileSystemInterface::EXISTS_RENAME);
          if ($moved_uri) {
            $file->setFileUri($moved_uri);
            $file->save();
            $files_moved++;
            $files_updated++;
          }
        }
        catch (\Exception $e) {
          $errors[] = t('Failed to move file @fid: @error', [
            '@fid' => $fid,
            '@error' => $e->getMessage(),
          ]);
        }
      }
      else {
        $file->setFileUri($new_uri);
        $file->save();
        $files_updated++;
      }
    }
  }

  \Drupal::cache()->invalidateAll();
  drupal_flush_all_caches();

  if (!empty($errors)) {
    \Drupal::logger('api_application')->error('File migration errors: @errors', ['@errors' => implode(', ', $errors)]);
  }

  return t('Migrated @count file records from public to private storage. @moved files physically moved. @errors errors encountered.', [
    '@count' => $files_updated,
    '@moved' => $files_moved,
    '@errors' => count($errors),
  ]);
}

/**
 * Remove purpose_of_loan field and purpose_of_the_loan taxonomy.
 */
function api_application_update_11021(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $term_storage = $entity_type_manager->getStorage('taxonomy_term');
  $vocabulary_storage = $entity_type_manager->getStorage('taxonomy_vocabulary');
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  $messages = [];

  // Delete all terms from purpose_of_the_loan vocabulary.
  $terms = $term_storage->loadByProperties([
    'vid' => 'purpose_of_the_loan',
  ]);

  if (!empty($terms)) {
    $term_storage->delete($terms);
    $messages[] = t('Deleted @count terms from purpose_of_the_loan vocabulary.', ['@count' => count($terms)]);
  }

  // Delete the purpose_of_the_loan vocabulary.
  $vocabulary = $vocabulary_storage->load('purpose_of_the_loan');
  if ($vocabulary) {
    $vocabulary->delete();
    $messages[] = t('Deleted purpose_of_the_loan vocabulary.');
  }

  // Remove the field storage definition.
  $field_storage_definition = $update_manager->getFieldStorageDefinition('purpose_of_loan', 'application');
  if ($field_storage_definition) {
    $update_manager->uninstallFieldStorageDefinition($field_storage_definition);
    $messages[] = t('Removed purpose_of_loan field from application entity.');
  }

  return !empty($messages) ? implode(' ', $messages) : t('purpose_of_loan cleanup already completed.');
}
