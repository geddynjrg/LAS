<?php

/**
 * @file
 * Admin fixes for Uwezo Drupal backends.
 */

use Drupal\Core\Site\Settings;

/**
 * Implements hook_module_implements_alter().
 */
function uwezo_admin_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook === 'page_attachments_alter' && isset($implementations['uwezo_admin'])) {
    $implementation = $implementations['uwezo_admin'];
    unset($implementations['uwezo_admin']);
    $implementations['uwezo_admin'] = $implementation;
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function uwezo_admin_page_attachments_alter(array &$attachments): void {
  if (empty($attachments['#attached']['drupalSettings']['gin_login']['path'])) {
    return;
  }

  $host = $_SERVER['HTTP_X_FORWARDED_HOST'] ?? $_SERVER['HTTP_HOST'] ?? '';
  $host = trim(explode(',', $host)[0]);

  $redirect = Settings::get('ecitizen_oauth')['redirect_uri'] ?? '';
  if (preg_match('#https?://([^/]+)#', $redirect, $matches)) {
    $host = $matches[1];
  }
  elseif ($host === '' || preg_match('/^\d{1,3}(\.\d{1,3}){3}$/', $host)) {
    return;
  }

  $proto = 'https';
  if (!empty($_SERVER['HTTP_X_FORWARDED_PROTO'])) {
    $proto = trim(explode(',', $_SERVER['HTTP_X_FORWARDED_PROTO'])[0]);
  }
  elseif (empty($_SERVER['HTTPS']) || $_SERVER['HTTPS'] === 'off') {
    $proto = 'http';
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('gin_login');
  $attachments['#attached']['drupalSettings']['gin_login']['path'] =
    $proto . '://' . $host . '/' . $module_path;
}
