{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "next lint",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "prettier": "prettier --write ./",
    "ci:prettier": "prettier --check ./",
    "pre-push": "pnpm run lint && pnpm run prettier && pnpm run tsc",
    "find-deadcode": "ts-prune",
    "prepare": "cd .. && npx husky",
    "check-types": "tsc --noEmit",
    "quality": "pnpm run lint && pnpm run prettier && pnpm run check-types",
    "schema": ". ./.env.local && openapi-typescript \"$API_URL/api/docs/json\" -o ./lib/api/schema/schema.d.ts --prettier && echo 'Schema updated successfully'",
    "schema:dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm run schema",
    "schema:validate": "tsc --noEmit --skipLibCheck ./lib/api/schema/schema.d.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx lib/worker/sync-worker.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --cache --fix",
    "*.{ts,tsx,js,css,md}": "prettier --write"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@tabler/icons-react": "^3.17.0",
    "@workspace/ui": "workspace:*",
    "nanoid": "^5.1.5",
    "next-auth": "5.0.0-beta.25",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.13.5",
    "prisma": "^6.11.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@next/eslint-plugin-next": "^15.2.4",
    "@tailwindcss/postcss": "^4.1.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.13.17",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.0.8",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "lint-staged": "^16.1.5",
    "next": "16.0.8",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "styled-jsx": "^5.1.7",
    "tailwindcss": "^4.1.3",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
