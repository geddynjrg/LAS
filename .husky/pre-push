# husky

# Get list of files that changed since last push
CHANGED_FILES=$(git diff --name-only @{push}..HEAD)

# Check if there are PHP files in admin directory
PHP_FILES=$(echo "$CHANGED_FILES" | grep "^admin/" | grep -E "\.(php|module|inc|install|test|profile|theme|twig|yml|yaml)$" || true)

# Check if there are JS/TS files in web directory
JS_FILES=$(echo "$CHANGED_FILES" | grep "^web/" | grep -E "\.(js|jsx|ts|tsx|css|md)$" || true)

echo "🚀 Running pre-push checks..."

# Initialize exit status
PHP_EXIT_CODE=0
JS_EXIT_CODE=0

echo "========================================="
echo "🚀 UWEZO PRE-PUSH QUALITY CHECKS"
echo "========================================="

# Run GrumPHP for admin PHP files
if [ -n "$PHP_FILES" ]; then
  echo ""
  echo "📋 STEP 1/2: Comprehensive PHP Checks"
  echo "------------------------------------"
  cd admin
  vendor/bin/grumphp run
  PHP_EXIT_CODE=$?
  cd ..

  if [ $PHP_EXIT_CODE -ne 0 ]; then
    echo "❌ PHP comprehensive checks FAILED"
  else
    echo "✅ PHP comprehensive checks PASSED"
  fi
else
  echo ""
  echo "⏭️  STEP 1/2: No PHP files to check - SKIPPED"
fi

# Always run web checks if there are JS files
if [ -n "$JS_FILES" ]; then
  echo ""
  echo "🎯 STEP 2/2: Comprehensive Web Checks"
  echo "------------------------------------"
  cd web
  pnpm run pre-push
  JS_EXIT_CODE=$?
  cd ..

  if [ $JS_EXIT_CODE -ne 0 ]; then
    echo "❌ Web comprehensive checks FAILED"
  else
    echo "✅ Web comprehensive checks PASSED"
  fi
else
  echo ""
  echo "⏭️  STEP 2/2: No web files to check - SKIPPED"
fi

echo ""
echo "========================================="
echo "📊 FINAL RESULTS"
echo "========================================="

# Final result
if [ $PHP_EXIT_CODE -eq 0 ] && [ $JS_EXIT_CODE -eq 0 ]; then
  echo "🎉 ALL CHECKS PASSED - Push allowed!"
else
  echo "💥 SOME CHECKS FAILED - Push blocked!"
  echo ""
  if [ $PHP_EXIT_CODE -ne 0 ]; then
    echo "   ❌ PHP checks failed"
  fi
  if [ $JS_EXIT_CODE -ne 0 ]; then
    echo "   ❌ Web checks failed"
  fi
  echo ""
  exit 1
fi