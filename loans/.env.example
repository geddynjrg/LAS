# Production loans portal — shares staging MariaDB (uwezo-db-1 via hostname db).
# Copy to loans/.env on the server and fill in real values. Never commit .env.

STAGING_DB_NAME=drupal
STAGING_DB_USER=drupal
STAGING_DB_PASSWORD=changeme

PROD_WEB_DOMAIN=loans.uwezo.go.ke
PROD_ADMIN_DOMAIN=loans-admin.uwezo.go.ke

LMS_API_URL=https://lms.uwezo.go.ke
LMS_API_HOST=lms.uwezo.go.ke
LMS_API_KEY=changeme

HASH_SALT=changeme
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
CRON_SECRET=changeme
EXTERNAL_API_KEY=changeme

EBISCLOUD_SMS_API_KEY=changeme
EBISCLOUD_SMS_API_URL=https://sms.ebisclouderp.com/api/sms/sendsms
EBISCLOUD_SMS_SHORTCODE=Uwezo Fund
EBISCLOUD_SMS_SERVICE_ID=0

ECITIZEN_CLIENT_ID=changeme
ECITIZEN_CLIENT_SECRET=changeme
ECITIZEN_AUTH_URL=https://accounts.ecitizen.go.ke/oauth/authorize
ECITIZEN_TOKEN_URL=https://accounts.ecitizen.go.ke/oauth/access-token
ECITIZEN_USER_INFO_URL=https://accounts.ecitizen.go.ke/api/user-info

PROD_SMTP_HOST=mail.govmail.ke
PROD_SMTP_PORT=587
PROD_SMTP_USER=loans@uwezo.go.ke
PROD_SMTP_PASSWORD=changeme

PESAFLOW_CHECKOUT_URL=
