{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "NODE_TLS_REJECT_UNAUTHORIZED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**",
        "dist/**"
      ],
      "env": [
        "NEXT_API_URL",
        "NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "UPLOAD_DIR",
        "MAX_FILE_SIZE",
        "DATABASE_URL",
        "EXTERNAL_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview-storybook": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
